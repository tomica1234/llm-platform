#!/usr/bin/env bash
# Render only through the validated Slurm adapter.
#SBATCH --job-name=llm-DEPLOYMENT_ID
#SBATCH --comment=INSTANCE_ID
# Optional, emitted only when platform slurm.qos is explicitly configured:
# SBATCH --qos=REVIEWED_QOS
#SBATCH --gres=gpu:GPU_COUNT
#SBATCH --cpus-per-task=CPU_COUNT
#SBATCH --mem=RAM_GB
set -euo pipefail
exec /opt/llm-platform/app/current/bin/llm-backend \
  --instance INSTANCE_ID --deployment DEPLOYMENT_ID --config-dir /etc/llm-platform
