[Unit]
Description=LLM backend service wrapper for instance %i
After=network.target munge.service slurmd.service

[Service]
Type=simple
User=svc-llm
Group=svc-llm
EnvironmentFile=/etc/llm-platform/backend.env
ExecStart=/opt/llm-platform/gateway/current/bin/llm-backend --instance %i
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/models
ReadWritePaths=/scratch/svc-llm /var/log/llm-platform/backends
UMask=0077
